<!doctype html>
<html lang="no" data-color-mode="light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta
            name="htmx-config"
            content='{
                "responseHandling": [
                    {"code": "204", "swap": false},
                    {"code": "[23]..", "swap": true},
                    {"code": "422", "swap": true},
                    {"code": "[45]..", "swap": false, "error": true},
                    {"code": "...", "swap": true}
                ]
            }'
        />
        <title>Neste avgang</title>
        <link rel="stylesheet" href="/static/index.css" />
        <script src="/vendor/htmx/htmx.min.js" defer></script>
        <script src="/vendor/htmx-ext-sse/sse.js" defer></script>
    </head>
    <body>
        <a class="skip-link" href="#main-content">Hopp til hovedinnhold</a>

        <header class="page-header">
            <div>
                <p class="eyebrow">Trafikkstyring</p>
                <h1>🚉 Neste avgang</h1>
                <p>
                    En avgangstavle laget på serveren. Endre trafikken her, og se hva
                    nettleseren trenger for å holde følge.
                </p>
            </div>
        </header>

        <main id="main-content">
            <%- include('partials/summary', { summary, oob: false }) %>

            <section aria-labelledby="departures-heading" class="board-section">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Oslo S</p>
                        <h2 id="departures-heading">Avganger</h2>
                    </div>
                    <span class="connection-status" id="connection-status">
                        Liveoppdatering slått på
                    </span>
                </div>

                <form
                    action="/avganger"
                    class="search"
                    hx-get="/avganger"
                    hx-indicator=".spinner"
                    hx-push-url="true"
                    hx-swap="outerHTML"
                    hx-sync="this:replace"
                    hx-target="#live-departures"
                    hx-trigger="input changed delay:400ms from:#departure-search, submit"
                    method="GET"
                >
                    <label for="departure-search">Søk etter linje eller destinasjon</label>
                    <div class="search-row">
                        <input
                            autocomplete="off"
                            id="departure-search"
                            name="q"
                            type="search"
                            value="<%= query %>"
                        />
                        <button type="submit">Søk</button>
                        <span aria-hidden="true" class="spinner">●●●</span>
                    </div>
                </form>

                <%- include('partials/live-departures', {
                    departures,
                    query,
                    editId,
                    error,
                    formatTime,
                    expectedAt,
                }) %>
            </section>
        </main>
    </body>
</html>
